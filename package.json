{
  "name": "dev-tools",
  "private": true,
  "version": "1.0.0",
  "description": "本地优先的开发者工具箱，包含编码、加密、接口和文本处理工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:project": "vite build --mode github-pages",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "node --test tests",
    "test:e2e": "playwright test",
    "test:e2e:project": "playwright test --config playwright.project.config.js"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lucide/vue": "^1.30.0",
    "@vueuse/core": "^10.1.2",
    "@zxing/browser": "^0.1.5",
    "codemirror": "6.0.2",
    "crypto-js": "^4.1.1",
    "diff": "9.0.0",
    "jsbarcode": "^3.11.5",
    "jsencrypt": "^3.3.2",
    "jsonc-parser": "3.3.1",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.3",
    "sm-crypto": "^0.3.13",
    "vue": "^3.3.2",
    "vue-router": "^4.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-vue": "^4.2.3",
    "autoprefixer": "^10.4.14",
    "gh-pages": "^5.0.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0",
    "vite": "^4.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yisonli/dev_tools.git"
  },
  "homepage": "https://tool.7ys.top/"
}
